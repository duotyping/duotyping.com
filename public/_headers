# Cloudflare static-asset headers. Paths match what dist/ serves.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000

# Vite fingerprints everything it builds into /assets, so it can be kept for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app reads the Sparkle feed by exact URL. Always revalidate, so a new release is seen on the
# next check.
/appcast.xml
  Cache-Control: no-cache
