# Cloudflare static-asset headers. Paths match what dist/ serves.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000

# Vite fingerprints everything it builds into /assets, so it can be kept for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app reads these two by exact URL: the signed model catalog and the Sparkle feed. Always
# revalidate, so a re-signed catalog or a new release is seen on the next check.
/models.json
  Cache-Control: no-cache
/appcast.xml
  Cache-Control: no-cache
