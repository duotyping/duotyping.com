{
  // One config for the page and the build: it's a small static site.
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"],
  // An unknown component or attribute in a template is an error, not plain HTML.
  "vueCompilerOptions": { "strictTemplates": true }
}
